def calls(names, arg=False):
    """A call to one of names, with whatever qualifier precedes it (`.`, `->`, `ns::`)."""
    return re.compile(r"((?:[A-Za-z_]\w*)?::|\.|->)?\s*\b(" + names + r")\s*\(" + (STR if arg else ""))


def include(names):
