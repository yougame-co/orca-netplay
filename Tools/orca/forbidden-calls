    r"|(?P<block>/\*.*?(?:\*/|\Z))"
    r'|(?P<raw>\b(?:u8|[uUL])?R"(?P<d>[^ ()\\\t\n]{0,16})\(.*?\)(?P=d)")'
    r"|(?P<num>\b[0-9][0-9A-Za-z_'.]*)"  # 1'000 is a number, not a character literal
    r'|(?P<str>"(?:[^"\\\n]|\\.)*"?)'
    r"|(?P<chr>'(?:[^'\\\n]|\\.)*'?)",
    re.S,
)


def _spaces(text):
    return re.sub(r"[^\n]", " ", text)


def strip_c_comments(text, blank_strings=False):
    """Blanks out // and /* */ comments, keeping line breaks and columns. String and character
    literals are kept, or with blank_strings their contents become spaces (quotes stay)."""

    def sub(m):
        kind = m.lastgroup if m.lastgroup != "d" else "raw"
        t = m.group(0)
        if kind in ("line", "block"):
            return _spaces(t)
        if not blank_strings or kind == "num":
            return t
        if kind == "raw":
            q = t.index('"')
            return t[: q + 1] + _spaces(t[q + 1 : -1]) + t[-1]
        if len(t) >= 2 and t[-1] == t[0]:
            return t[0] + _spaces(t[1:-1]) + t[-1]
        return t[0] + _spaces(t[1:])

    return C_LEXEMES.sub(sub, text)


def strip_cmake_comments(text):
    return re.sub(r"(?m)#.*$", lambda m: " " * len(m.group(0)), text)


def norm(token):
    return re.sub(r"\s+", "", token)


def join_continuations(text):
    """Joins backslash-continued lines onto their first line, keeping the line count."""
    lines = text.split("\n")
    out, i = [], 0
    while i < len(lines):
        cur, n = lines[i], 1
        while cur.endswith("\\") and i + n < len(lines):
            cur = cur[:-1] + lines[i + n]
            n += 1
        out.append(cur)
        out.extend([""] * (n - 1))
        i += n
    return "\n".join(out)


ERASE_REMOVE = re.compile(r"\bremove(?:_if)?\s*\(\s*[\w.:>-]*(?:begin|cbegin)\s*\(")


def scan_c(path, text, cls="engine"):
    """Yields (rule, token, line number, line text). cls is the path's layer (game logic gets the
    stricter rules)."""
    game = cls == "game-logic"
    joined = join_continuations(text)
    lines = strip_c_comments(joined).split("\n")
    bare_lines = strip_c_comments(joined, blank_strings=True).split("\n")
    raw = text.split("\n")
    peer = any(r.match(path) for r in PEER_RE)

    def shown(no, line):
        return raw[no - 1].strip() if no - 1 < len(raw) else line.strip()

    for no, (line, bare) in enumerate(zip(lines, bare_lines), 1):
        if not line.strip():
            continue
        is_include = INCLUDE_LINE.match(line) is not None
        for rule, pats in RULES.items():
            if rule == "peer-parse" and not peer:
                continue
            if rule in GAME_ONLY and not game:
                continue
            for rx, kind in pats:
                if is_include != (kind == "include"):
                    continue
                # Calls and names are matched with string contents blanked (no "select (" in a
                # message), then read back from the real line so a string argument is kept.
                for m in rx.finditer(line if kind in ("include", "string") else bare):
                    if kind == "include":
                        token = "#include " + m.group(1)
                    elif kind.startswith("call"):
                        qual = (m.group(1) or "").strip()
                        if qual in (".", "->") and kind != "call-any":
                            continue
                        if kind == "call-global" and qual not in ("", "::"):
                            continue  # std::bind, asio::connect are not socket calls
                        if kind == "call-c" and qual not in ("", "::", "std::"):
                            continue  # HostFileSystem::Rename is not rename(2)
                        token = norm(line[m.start() : m.end()])
                        if qual in (".", "->"):
                            token = token.lstrip(".->")
                            token = "." + token
                    else:
                        token = norm(line[m.start() : m.end()])
                    hit_rule = rule
                    if rule == "process" and re.match(r"\s*(?:(?:std)?::)?\s*system\s*\(\s*system_\s*\)",
                                                      bare[m.start():]):
                        continue  # a member initializer, `: system(system_)` (Boot.cpp)
                    if rule == "file-open":
                        if ERASE_REMOVE.search(bare[m.start():]):
                            continue  # std::remove(v.begin(), ...): the erase-remove idiom
                        # Outside game logic, a path built from the user or Sys directory is its
                        # own (baselined) rule, unless it climbs out with `..`.
                        if not game and USER_DIR.search(bare) and not DOTDOT.search(line):
                            hit_rule = "file-user"
                    yield hit_rule, token, no, shown(no, line)
        if game and not is_include:
            for m in BARE.finditer(bare):
                name = m.group(1) or m.group(2)
                yield bare_rule(name), "bare " + norm(m.group(0)), no, shown(no, line)


def scan_cmake(path, text):
    code = strip_cmake_comments(text)
    raw = text.split("\n")
    for m in re.finditer(r"\b(" + CMAKE_CMDS + r")\s*\(([^()]*(?:\([^()]*\)[^()]*)*)\)", code, re.I):
        cmd = m.group(1)
        args = [a for a in re.split(r"\s+", m.group(2).strip()) if a]
        no = code.count("\n", 0, m.start()) + 1
        first = raw[no - 1].strip()
        if not args:
            continue
        low = cmd.lower()
        if low in ("target_link_libraries", "link_libraries"):
            target = args[0] if low == "target_link_libraries" else ""
            for lib in args[1:] if target else args:
                if lib in CMAKE_KEYWORDS:
                    continue
                yield "build-deps", "%s(%s %s)" % (low, target, lib), no, first
        elif low == "file":
            if args[0].upper() in CMAKE_FILE_ARGS:
                yield "build-deps", "file(%s)" % args[0].upper(), no, first
        elif low in CMAKE_COMPILE_OPTION_CMDS:
            for a in args:
                if re.match(r'"?(?:-include|/FI|-imacros)', a):
                    yield "build-deps", "%s(%s)" % (low, a.strip('"')), no, first
        else:
            yield "build-deps", "%s(%s)" % (low, args[0]), no, first


def is_cmake(path):
    return os.path.basename(path) == "CMakeLists.txt" or path.endswith(".cmake")


def scannable(path, rules):
    m = rules.classify(path)
    if m.dev:
        return False
    # Game logic: every file (a .inc, a .txt it #includes); binary files are skipped when read.
    return m.cls == "game-logic" or path.endswith(C_EXTS) or is_cmake(path)


def scan_text(path, text, cls="engine"):
    if is_cmake(path):
        return list(scan_cmake(path, text))
    if "\0" in text:
        return []
    return list(scan_c(path, text, cls))


def read_files(repo, rev, paths):
    """Contents of paths at rev (None = the working tree). Skips submodules and directories."""
    if rev is None:
        for p in paths:
            full = os.path.join(repo, p)
            if os.path.isfile(full):
                with open(full, "rb") as f:
                    yield p, f.read().decode("utf-8", "replace")
        return
    import subprocess

    wanted = set(paths)
    listing = layerlib.git(repo, "ls-tree", "-r", "-z", rev) if paths else ""
    blobs = []
    for rec in listing.split("\0"):
        if not rec:
            continue
        meta, p = rec.split("\t", 1)
        mode, kind, sha = meta.split()
        if p in wanted and kind == "blob" and not mode.startswith("12"):
            blobs.append((p, sha))
    if not blobs:
        return
    proc = subprocess.Popen(["git", "-C", repo, "cat-file", "--batch"], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE)
    data, _ = proc.communicate("".join(sha + "\n" for _, sha in blobs).encode())
    pos = 0
    for p, sha in blobs:
        end = data.index(b"\n", pos)
        header = data[pos:end].split()
        size = int(header[2])
        body = data[end + 1 : end + 1 + size]
        pos = end + 1 + size + 1
        yield p, body.decode("utf-8", "replace")


def load_baseline(text):
    base = Counter()
    for no, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 4 or parts[1] not in ALL_RULES:
            raise ValueError("baseline line %d: expected <count> <rule> <path> <token>" % no)
        base[(parts[1], parts[2], parts[3])] += int(parts[0])
    return base


def format_baseline(counts, base_commit):
    lines = [
        "# Tools/orca/forbidden-calls baseline: the hits Orca's shipped code is allowed today.",
        "# Rewrite with `Tools/orca/forbidden-calls --update-baseline`; a person reviews the diff.",
        "# Scanned against upstream base %s." % base_commit,
        "# <count>\\t<rule>\\t<path>\\t<token>",
    ]
    for (rule, path, token), n in sorted(counts.items(), key=lambda kv: (kv[0][1], kv[0][0], kv[0][2])):
        lines.append("%d\t%s\t%s\t%s" % (n, rule, path, token))
    return "\n".join(lines) + "\n"


def added_lines(repo, since, rev, paths):
    """{path: set(line numbers)} added since rev left since (their merge-base) up to rev (None = the
    working tree): a stale branch's lines, not the newer lines of since it lacks."""
    if not paths:
        return {}
    base = layerlib.git(repo, "merge-base", since, rev or "HEAD", check=False).strip() or since
    spec = [base] + ([rev] if rev else [])
    diff = layerlib.git(repo, "diff", "-U0", "--no-renames", *spec, "--", *paths)
    out, cur = defaultdict(set), None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            p = line[4:].strip()
            cur = None if p == "/dev/null" else (p[2:] if p.startswith("b/") else p)
        m = re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))? @@", line)
        if m and cur:
            start, count = int(m.group(1)), int(m.group(2) or "1")
            out[cur].update(range(start, start + count))
    return out


def main():
    ap = argparse.ArgumentParser(
        description="New forbidden calls in Orca's shipped code, against a baseline.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split("\n\n", 1)[1],
    )
    ap.add_argument("--rev", help="scan this revision instead of the working tree")
    ap.add_argument("--since", help="mark hit lines added since this revision")
    ap.add_argument("--baseline", help="baseline file (default: %s)" % BASELINE_IN_REPO)
    ap.add_argument("--baseline-rev", help="read the baseline at this revision")
    ap.add_argument("--rules", help="a layers.txt other than this checkout's")
    ap.add_argument("--rules-rev", help="read layers.txt at this revision")
    ap.add_argument("--update-baseline", action="store_true")
    ap.add_argument("--list", action="store_true", help="print every hit")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--repo")
    args = ap.parse_args()

    try:
        repo = args.repo or layerlib.repo_root()
        for trusted in sorted(set(r for r in (args.rules_rev, args.baseline_rev) if r)):
            layerlib.check_tools_at(repo, trusted)
        rules = (layerlib.load_rules(repo=repo, rev=args.rules_rev) if args.rules_rev
                 else layerlib.load_rules(args.rules))
        paths, base_commit = layerlib.orca_paths(repo, rules, args.rev)
        paths = [p for p in paths if scannable(p, rules)]
        hits = []
        for p, text in read_files(repo, args.rev, paths):
            for rule, token, no, line in scan_text(p, text, rules.classify(p).cls):
                hits.append({"rule": rule, "path": p, "token": token, "line": no, "text": line})
    except (layerlib.GitError, layerlib.RulesError, OSError) as e:
        layerlib.die("forbidden-calls: %s" % e)

    counts = Counter((h["rule"], h["path"], h["token"]) for h in hits)
    if args.update_baseline:
        target = args.baseline or DEFAULT_BASELINE
        with open(target, "w", encoding="utf-8") as f:
            f.write(format_baseline(counts, base_commit))
        print("forbidden-calls: wrote %d keys (%d hits in %d files) to %s" % (
            len(counts), len(hits), len(paths), os.path.relpath(target, repo)))
        return 0

    try:
        if args.baseline_rev:
            base_text = layerlib.git(repo, "show", "%s:%s" % (args.baseline_rev, BASELINE_IN_REPO))
        else:
            with open(args.baseline or DEFAULT_BASELINE, encoding="utf-8") as f:
                base_text = f.read()
        baseline = load_baseline(base_text)
    except (layerlib.GitError, OSError, ValueError) as e:
        layerlib.die("forbidden-calls: baseline: %s" % e)

    # A file the baseline has never seen (Orca's first change to an upstream Dolphin file) is held
    # to upstream's own hits in it, so only what Orca adds is new.
    fresh = sorted(set(h["path"] for h in hits) - set(k[1] for k in baseline))
    upstream = Counter()
    try:
        for p, text in read_files(repo, base_commit, fresh):
            for rule, token, _, _ in scan_text(p, text, rules.classify(p).cls):
                upstream[(rule, p, token)] += 1
    except (layerlib.GitError, OSError) as e:
        layerlib.die("forbidden-calls: upstream copies: %s" % e)

    def allowed(k):
        return baseline.get(k, 0) + upstream.get(k, 0)

    new_keys = {k: (n, allowed(k)) for k, n in counts.items() if n > allowed(k)}
    gone = {k: (counts.get(k, 0), n) for k, n in baseline.items() if counts.get(k, 0) < n}
    marked, edited = {}, []
    game_paths = set(h["path"] for h in hits if rules.classify(h["path"]).cls == "game-logic")
    if args.since:
        try:
            marked = added_lines(repo, args.since, args.rev,
                                 sorted(set(k[1] for k in new_keys) | game_paths))
        except layerlib.GitError as e:
            layerlib.die("forbidden-calls: --since: %s" % e)
        # Game logic: a hit on a line the change added is reported even when no count rose (a
        # baselined line edited to write elsewhere, or a call moved onto a new line).
        edited = [h for h in hits if h["path"] in game_paths and h["line"] in marked.get(h["path"], ())
                  and (h["rule"], h["path"], h["token"]) not in new_keys]

    report = []
    for (rule, path, token), (now, allowed) in sorted(new_keys.items(), key=lambda kv: (kv[0][1], kv[0][0])):
        where = [h for h in hits if (h["rule"], h["path"], h["token"]) == (rule, path, token)]
        report.append({
            "rule": rule, "path": path, "token": token, "count": now, "baseline": allowed,
            "lines": [{"line": h["line"], "text": h["text"],
                       "added": h["line"] in marked.get(path, ())} for h in where],
        })

    if args.json:
        json.dump({"scanned_files": len(paths), "upstream_base": base_commit, "hits": len(hits),
                   "new_to_baseline": fresh, "new": report, "edited": edited,
                   "gone": [{"rule": r, "path": p, "token": t, "count": c, "baseline": b}
                            for (r, p, t), (c, b) in sorted(gone.items())],
                   "all": hits if args.list else None}, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 1 if report or edited else 0

    out = sys.stdout.write
    out("forbidden-calls: %d files at %s, %d hits, upstream base %s\n" % (
        len(paths), args.rev or "the working tree", len(hits), base_commit[:10]))
    if fresh:
        out("%d file%s new to the baseline, held to upstream's hits in %s: %s\n" % (
            len(fresh), "" if len(fresh) == 1 else "s", "it" if len(fresh) == 1 else "them",
            ", ".join(fresh[:8]) + (" ..." if len(fresh) > 8 else "")))
    if args.list:
        for h in sorted(hits, key=lambda h: (h["path"], h["line"])):
            out("  %-10s %s:%d  %s\n" % (h["rule"], h["path"], h["line"], h["token"]))
    if report:
        out("\n%d NEW (not in the baseline):\n" % sum(r["count"] - r["baseline"] for r in report))
        for r in report:
            out("  %-10s %s  %s  (%d now, %d allowed)\n" % (r["rule"], r["path"], r["token"],
                                                           r["count"], r["baseline"]))
            for l in r["lines"]:
                out("      %s%d: %s\n" % ("+" if l["added"] else " ", l["line"], l["text"][:160]))
    else:
        out("no new hits\n")
    if edited:
        out("\n%d in game logic on lines this change added (a person looks):\n" % len(edited))
        for h in edited:
            out("  %-10s %s:%d  %s\n      %s\n" % (h["rule"], h["path"], h["line"], h["token"],
                                                  h["text"][:160]))
    if gone:
        out("\n%d baseline entr%s no longer seen (refresh with --update-baseline):\n" % (
            len(gone), "y is" if len(gone) == 1 else "ies are"))
        for (rule, path, token), (now, allowed) in sorted(gone.items())[:20]:
            out("  %-10s %s  %s  (%d now, %d allowed)\n" % (rule, path, token, now, allowed))
    return 1 if report or edited else 0


if __name__ == "__main__":
    sys.exit(main())
