// Microsoft Visual C++ generated resource script.
//
#include "resource.h"
#include "orca-version.h"
#include <winver.h>
IDI_ICON1               ICON                    "..\\..\\..\\Installer\\Orca.ico"
"dolphin"               ICON                    "..\\..\\..\\Installer\\Orca.ico"

// What Windows, Task Manager and antivirus show for the program (yg-dolphin.exe from 0.3.42,
// yg-baiji.exe in 0.3.40 and 0.3.41, Orca.exe before).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ORCA_VERSION_NUM
 PRODUCTVERSION ORCA_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "YouGame"
      VALUE "FileDescription", "YG Dolphin"
      VALUE "FileVersion", ORCA_VERSION_STR
      VALUE "InternalName", "yg-dolphin"
      VALUE "LegalCopyright", "GPL-2.0-or-later. Based on the Dolphin emulator."
      VALUE "OriginalFilename", "yg-dolphin.exe"
      VALUE "ProductName", "YG Dolphin"
      VALUE "ProductVersion", ORCA_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
