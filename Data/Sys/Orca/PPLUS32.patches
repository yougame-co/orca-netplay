8117B394 901D0634 901D0634    # (guard)
8117B398 4800000C 4800000C    # (guard)
8117B39C 3800001C 3800001C    # li   r0, 0x1C (Options; guard)
8117B3A0 901D0634 901D0634    # (guard)
8117B3A4 7FA3EB78 7FA3EB78    # mr   r3, r29 (into the page; guard)
8117B3A8 38800001 38800001    # (guard)
8117B3AC 4B52A6AD 4B52A6AD    # bl   0x806A5A58 (guard)
8117B3B0 38000003 38000003    # (guard)
