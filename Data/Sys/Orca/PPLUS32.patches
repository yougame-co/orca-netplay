# sqMenuMain::setNext's table in Brawl's sora_scene, which Project+ does not replace (the same
# words as in Brawl): every online code (24-27, 29, 30, 31) goes to sqVsMelee, Project+'s local
# VERSUS character select, through the block below. Code 28 is a guard; 24-27 already point at the
# block's address.
80701A04 806DC8C8 806DC8C8    # code 24 (guard: the block below)
80701A08 806DC8C8 806DC8C8    # code 25 (guard)
80701A0C 806DC8C8 806DC8C8    # code 26 (guard)
80701A10 806DC8C8 806DC8C8    # code 27 (guard)
80701A14 806DC940 806DC940    # code 28 (guard)
80701A18 806DC8E0 806DC8C8    # code 29 (sqNetAnyWatch)
80701A1C 806DC8F8 806DC8C8    # code 30 (sqNetAnyOkiraku)
80701A20 806DC910 806DC8C8    # code 31 (sqNetAnyTeamMelee)

# B out of that character select goes back to the page it came from (the ONLINE page on With
# Friends, With Anyone on Casual or Ranked), not to VERSUS: RSBE01.patches describes these
# groups for Brawl. Project+ keeps Brawl's sqMenuMain, sqVsMelee and their tables (the original
# words read in Project+'s RAM on its character select and main menu, 2026-10-03), but its codeset
# makes sqVsMelee::start always keep the character select as it was (0x806DCA90 is a `b`), so the
# exit code is kept by the menu's block, not by that start. The menu's mode puts the cursor back on
# the button in Project+'s own copy of the menu module too.
806DC8C8 80B20284 7E439378    # mr     r3, r18
806DC8CC 7E439378 38930030    # addi   r4, r19, 48 ("sqVsMelee", as VERSUS)
806DC8D0 38930160 38A00000    # li     r5, 0 (its argument, as VERSUS)
806DC8D4 4B950D6D 4B950D6D    # bl     setNextSequence (0x8002D640; guard)
806DC8D8 93CF0008 80720014    # lwz    r3, 0x14(r18) (the next sequence: sqVsMelee)
806DC8DC 480000F4 80120284    # lwz    r0, 0x284(r18) (the menu's exit code)
806DC8E0 7E439378 90030018    # stw    r0, 0x18(r3) (kept for the back out)
806DC8E4 38930170 93CF0008    # stw    r30, 0x8(r15)
806DC8E8 38A00000 480000E8    # b      0x806DC9D0
806DC8EC 4B950D55 80AF0018    # helper: lwz r5, 0x18(r15) (r15 is sqVsMelee there)
806DC8F0 93CF0008 38000000    # li     r0, 0
806DC8F4 480000DC 900F0018    # stw    r0, 0x18(r15) (used once)
806DC8F8 7E439378 3805FFE8    # subi   r0, r5, 24
806DC8FC 38930180 28000007    # cmplwi r0, 7
806DC900 38A00000 41810018    # bgt    0x806DC918 (not an online code)
806DC904 4B950D3D 38A5FFFE    # subi   r5, r5, 2
806DC908 93CF0008 28000004    # cmplwi r0, 4
806DC90C 480000C4 4C800020    # bgelr  (29-31: With Anyone, 27-29)
806DC910 7E439378 38A0001E    # li     r5, 30 (24-27: the ONLINE page on With Friends)
806DC914 38930190 4E800020    # blr
806DC918 38A00000 38A00001    # li     r5, 1 (VERSUS, as before)
806DC91C 4B950D25 4E800020    # blr

# sqVsMelee::setNext's state 16, the back out (0x806DCE34): the argument comes from the helper.
806DCE34 806F0014 806F0014    # lwz    r3, 0x14(r15) (guard)
806DCE38 38910064 38910064    # addi   r4, r17, 100 ("sqMenuMain"; guard)
806DCE3C 38A00001 4BFFFAB1    # li r5, 1 -> bl 0x806DC8EC (r5: the argument)
806DCE40 4B950801 4B950801    # bl     setNextSequence (guard)

# The online rules' lock on the way out (ORCA.md "Online rules"): while the match block's header
# (UX/MatchBlock.h, 0x806F2380) says casual or ranked, sqVsMelee::setNext's state 5, which takes the
# character select's result, sends anything but "go on" (its BACK button, held B) to state 4, the
# character select again, the way the stage select's B comes back to it (state 7), instead of
# state 16, the menu. No way out of the character select in a queue match; without a header
# (friends, solo) the menu as before, and so on the queue's own character select before a match
# (the header's FLAG_SOLO, UX/Queue.h), where B backing out ends the search. A toggled group
# (GamePatches.h): r24 is 4 and r20 16 through
# the whole function.
when 806F2380 == 59474D31               # the block's magic, 'YGM1'
when 806F2384 & 00FF0000 != 00000000    # its mode: casual or ranked
when 806F238C & 01000000 == 00000000    # not the queue's own character select (FLAG_SOLO): B backs out
806DCBFC 4182000C 4182000C    # beq    0x806DCC08 (go on: state 6, the stage select; guard)
806DCC00 928F0008 930F0008    # stw    r20, 8(r15) (16) -> stw r24, 8(r15) (4)
806DCC04 48000008 48000008    # b      0x806DCC0C (guard)
end

# Project+'s own "Move v-sync call for Brawl/PM" (its codes write these two words with plain stores
# from frame 1 on), the same groups as RSBE01.patches: written here at the first live boundary
# through the memory-patch path, which drops the JIT's copies, so every machine runs the move from
# frame 1 whatever its JIT compiled during the boot, and the codes then write the same words. See
# ORCA.md "Code the JIT doesn't see".
80023B84 2C000000 2C000000    # cmpwi r0, 0 (guard)
80023B88 4182FF7C 60000000    # beq   0x80023B04 -> nop
80023B8C 881F0074 881F0074    # lbz   r0, 0x74(r31) (guard)

80024020 7C0803A6 7C0803A6    # mtlr  r0 (guard)
80024024 38210020 38210020    # addi  r1, r1, 0x20 (guard)
80024028 4E800020 481C4904    # blr -> b 0x801E892C (VIWaitForRetrace, a tail call)

# The rules menu's item default, as RSBE01.patches sets it for Brawl (which describes these four
# words of Brawl's gmGlobalRecord menu data): Project+ keeps Brawl's record and its Item Switch page
# reads and writes the same words. With no save in the session NAND every match had items at
# Medium: Project+'s netplay codeset ("Default Settings Modifier") sets the stock rules but not the
# items (its tournament variants, disabled, turn them off). Instead, once, while all four words
# still hold the defaults: the frequency None, which Project+ itself takes as every item off in a
# match ("Items spoofed off if item frequency None"). The switch is left as Project+ set it (its
# GameGlobal::init hook clears the Mayhem and Passive Aggression bits, 0x00180000), so choosing a
# frequency in the rules menu brings its usual items back. The second word becomes 'ORCA' so the
# group never lands again: a player's own choice stays, Medium included. A data group, not code:
# the record is not a module, and after the boot Project+ writes these words only when a player
# leaves its Item Switch page (checked in Project+'s RAM and in its codeset's source on the SD card,
# 2026-10-02).
9017BE50 02000000 00000000    # item frequency: Medium -> None
9017BE54 00000000 4F524341    # menu data +4 (unused): 'ORCA', the group has landed
9017BE58 FFE7FFFF FFE7FFFF    # item switch: Project+'s default (guard only, left as is)
9017BE5C FFFFFFFF FFFFFFFF    # (guard only)

# Options > Sound's balance slider stays in the middle, as RSBE01.patches does for Brawl (which
# describes the handler): Project+ keeps Brawl's record and its own sora_menu_main has the same
# Sound page at the same offsets, so the words are Brawl's + 0x1480 (read in Project+'s RAM on the
# Sound page, 2026-10-07; its codeset doesn't touch the page or the balance). In a room the host's
# slider silenced the friend's music (two Project+ Orcas, 2026-10-07). Clamp instead of lock (10 to
# 90): 2800005A and 2C00000A, as in Brawl's file.
8117C8BC A003066C A003066C    # lhz    r0, 0x66C(r3) (the slider's value; guard)
8117C8C0 28000064 28000032    # cmplwi r0, 100 -> 50: left stops at 50
8117C8C4 408000B4 408000B4    # bge    0x8117C978 (to the right check; guard)

8117C980 A003066C A003066C    # lhz    r0, 0x66C(r3) (guard)
8117C984 2C000000 2C000032    # cmpwi  r0, 0 -> 50: right stops at 50
8117C988 418200B0 408100B0    # beq -> ble 0x8117CA38 (the handler's end)
