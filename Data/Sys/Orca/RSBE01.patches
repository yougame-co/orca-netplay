81179F98 907D066C 4AEFA319    # bl   0x800742B0 (the sound)
81179F9C 48000234 48000234    # b    0x8117A1D0 (li r3, 0; the end; guard)

8117A104 3800001A 48000068    # li r0, 0x1A -> b 0x8117A16C
8117A108 901D0634 901D0634    # (guard)
