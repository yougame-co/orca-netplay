# sets bits 0-8 (Marth, Luigi, Ness), here all 42. Then 0x80 bytes of state 2 at +0x1528, as the
# community code writes them.
9017B640 * FFFFFFFF
9017B644 * 000003FF
9017CB68 * 02020202
